[Unit]
Description=LoopSkill API (FastAPI on port 3370)
After=network.target postgresql.service

[Service]
Type=simple
User=wisechef
Group=wisechef
WorkingDirectory=/home/wisechef/loopskill-api
EnvironmentFile=/home/wisechef/loopskill-api/.env
ExecStartPre=-/usr/bin/fuser -k 3370/tcp
# proxy-headers + forwarded-allow-ips (chef_2026-10-09-E): uvicorn rewrites
# request.client from X-Forwarded-For/X-Real-IP ONLY when the direct peer is
# 127.0.0.1 — which is exactly the topology (Caddy on the same host). This is
# what makes real client IPs visible to the app (rate-limit buckets, install
# provenance, error attribution) instead of logging every Cloudflare-fronted
# request as ::1. app.utils.client_ip additionally validates against
# TRUSTED_PROXY_CIDRS, so spoofed headers from non-trusted peers still fail
# closed. Note: uvicorn >= 0.29 defaults --proxy-headers on, but the flag is
# pinned explicitly here so the behavior cannot silently regress with a
# version bump, and --forwarded-allow-ips is required regardless (default
# trusts only 127.0.0.1 — which happens to match, but is stated explicitly
# so a future port/socket change does not silently untrust the proxy).
ExecStart=/home/wisechef/loopskill-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 3370 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
