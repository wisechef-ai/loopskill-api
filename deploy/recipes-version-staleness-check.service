[Unit]
Description=Recipes — daily version-staleness sweep (Phase F.8)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/recipes-api
EnvironmentFile=-/etc/recipes-api/recipes-api.env
# bundles0811-P8: catalog moved out of this repo to wisechef-ai/loopskill-recipes.
# Point --catalog at a checkout/clone of that repo on this host (kept in sync
# separately, e.g. via a `git pull` in a pre-start ExecStartPre or a deploy hook).
ExecStart=/opt/recipes-api/.venv/bin/python -m app.crons.version_staleness --catalog /opt/loopskill-recipes --json
StandardOutput=journal
StandardError=journal
